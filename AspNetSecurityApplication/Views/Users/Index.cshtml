@model IEnumerable<AspNetSecurityApplication.Models.ApplicationUser>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Users</h2>
        <div class="d-flex gap-2">
            <a href="/Auth/Logout" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
            <a href="/Users/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create User
            </a>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th style="width: 220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.Id</td>
                            <td>@u.FullName</td>
                            <td>@u.Email</td>
                            <td>
                                <a href="/Users/Edit/@u.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a href="/Users/Delete/@u.Id" class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
